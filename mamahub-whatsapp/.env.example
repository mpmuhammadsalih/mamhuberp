# Oracle Autonomous DB (thin TLS, no wallet)
DB_USERNAME=
DB_PASSWORD=
DB_DSN=

# Optional pool
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=8
ORACLE_TCP_CONNECT_TIMEOUT=15
ORACLE_LOCATION_CODE=1

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=14

# App
APP_NAME=MamaHub WhatsApp CRM
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8090
FRONTEND_URL=https://whatsapp.mamahub.store
CORS_ORIGINS=https://whatsapp.mamahub.store,http://127.0.0.1:3090,http://localhost:3090
UPLOAD_DIR=uploads

# Bootstrap admin (used only when no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@mamahub.store
BOOTSTRAP_ADMIN_NAME=MamaHub Admin

# WhatsApp — Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DISPLAY_NUMBER=
META_APP_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Company defaults (also stored in WA_SETTINGS)
COMPANY_NAME=MamaHub Trading
COMPANY_CURRENCY=QAR
COMPANY_COUNTRY=Qatar

# Web Push (installed phone app alerts)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@mamahub.store
