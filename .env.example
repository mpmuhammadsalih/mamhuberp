# Copy this file to .env and fill in your values.
# Do not commit .env to version control.

# Web UI wizard (browse to /database-setup — only when Oracle is not configured yet unless):
# DATABASE_SETUP_ALWAYS=1
# ALLOW_DATABASE_SETUP_WHILE_CONFIGURED=1
# DATABASE_SETUP_DISABLED=1  (hide wizard entirely)
# While connected: sign in as "admin" opens the wizard without the flags above (opt out: DATABASE_SETUP_NO_ADMIN_EDIT=1)
# Or set DATABASE_SETUP_EDIT_KEY=your-secret  — unlock from the /database-setup status page without restart

# Flask
FLASK_SECRET_KEY=change-me-to-a-secret-string
FLASK_PORT=5055
ITEMMASTER_TIMING_LOG=0

# Single database (Oracle) — used for all connections when multi-DB is off
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DSN=host:port/service_name

# Oracle Autonomous DB — TLS without wallet (recommended if you are not using a wallet)
# In OCI: Autonomous DB → Database connection → TLS authentication → copy connection string
# Paste the full string into DB_DSN, OR use simple host/port/service with ORACLE_USE_TCPS=1
#
# Option A — paste full TLS connect string from OCI (no wallet):
# DB_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=xxx_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
#
# Option B — simple form (driver adds TCPS + SSL):
# ORACLE_USE_TCPS=1
# DB_DSN=adb.region.oraclecloud.com:1522/xxx_high.adb.oraclecloud.com
#
# Option C — split env vars:
# ORACLE_USE_TCPS=1
# ORACLE_HOST=adb.region.oraclecloud.com
# ORACLE_PORT=1522
# ORACLE_SERVICE_NAME=xxx_high.adb.oraclecloud.com
#
# Optional: ORACLE_SSL_SERVER_CERT_DN="CN=..."  (from OCI if hostname match fails)
# ORACLE_SSL_SERVER_DN_MATCH=1                  (default on for TCPS)
#
# Wallet-based mTLS (only if your ADB requires it):
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=
# DB_DSN=myadb_high
#
# ORACLE_CLIENT_MODE=thin           # thin (default) or thick (requires Oracle Instant Client)
# ORACLE_CLIENT_LIB_DIR=
# ORACLE_TCP_CONNECT_TIMEOUT=15

# Multi-DB: set AUTH_DB_USERNAME + AUTH_DB_DSN (+ password); login/roles/tenant_databases use auth DB, business uses tenant DBs.
# For single-DB only: leave AUTH_DB_* blank OR force single mode without deleting lines:
# MULTI_DB_MODE=single

# RFIM schema — introspect all tables -> Python model file (run from project root):
#   python scripts/export_rfim_schema_to_models.py
# or: python scripts/oracle_introspect_models.py --profile rfim
# Output: addons/core/schema/generated/oracle_schema_rfim.py
# Example: rfim/rfim@192.168.1.225:1521/rgc
RFIM_USERNAME=rfim
RFIM_PASSWORD=
RFIM_DSN=192.168.1.225:1521/rgc

# --- Schema strategies (Odoo-like vs RFIM clone) ---
# (A) App-owned DDL at boot: AUTO_ENSURE_FULL_SCHEMA=1 runs db.get_app_owned_extended_bootstrap_steps()
#     (extend the list in db.py when adding a new ensure_* for a module).
# (B) One-time clone of full RFIM *structure* onto another Oracle user: run from repo root —
#       python scripts/oracle_export_schema_ddl.py --profile rfim -o exports/rfim.sql
#     Optional apply: scripts/oracle_apply_schema_ddl.py (see script docstrings; use Data Pump for data).
# (C) There is no in-app generator for all 300 legacy RFIM tables — use existing DB or (B).

# One-time: drop Oracle FK FK_TBLSETTLEMEN_TBLORD_0 (ORA-02291 parent key not found on settlement save).
# Restart the app after setting; multi-DB requires bootstrap to receive app= (normal Flask startup).
# DROP_FK_TBLSETTLEMEN_TBLORD=1

# Optional: on startup, also run extended db.ensure_* DDL (GL, warehouse, lots, etc.) — strategy (A)
# OFF by default / production — set only when you want the app to materialize these tables at boot.
# AUTO_ENSURE_FULL_SCHEMA=1
# Multi-DB only: also set BOOTSTRAP_SCHEMA_ALL_ACTIVE_TENANTS=1 so each tenant schema gets the extended block.
# BOOTSTRAP_SCHEMA_ALL_ACTIVE_TENANTS=0

# --- Performance (OCI / remote Oracle) ---
# Skip all startup DDL when schema already exists (biggest reload win):
# SKIP_STARTUP_SCHEMA_BOOTSTRAP=1
# Do not block HTTP until bootstrap completes (default off = background bootstrap):
# BOOTSTRAP_BLOCKING=0
# Disable parallel DML on pooled sessions (Autonomous DB; avoids ORA-12838):
# ORACLE_KEEP_PARALLEL_DML=0
# ORACLE_POOL_MIN=2
# ORACLE_POOL_MAX=8
# NEXA_UVICORN_RELOAD=0

# Generated Oracle models (optional): module basename under addons/core/schema/generated/, e.g. oracle_schema_rfim
# ORACLE_SCHEMA_MODULE=oracle_schema_rfim

# Oracle NLS_LANG – use UTF-8 so Arabic (e.g. ITEMNAMEARA) returns correctly.
# Default in code: AMERICAN_AMERICA.AL32UTF8
# NLS_LANG=AMERICAN_AMERICA.AL32UTF8
# Or for Arabic locale: NLS_LANG=ARABIC_UNITED_ARAB_EMIRATES.AL32UTF8

# Twilio (WhatsApp Send)
# Get these from https://console.twilio.com
# Sandbox: use whatsapp:+14155238886 and have recipients join your sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: SMS (Vodafone Connect)
# SMS_APP_USERNAME=
# SMS_APP_PASSWORD=
# SMS_MASK=RAWABI
# SMS_SOURCE=97489
