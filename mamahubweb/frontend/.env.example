# Vite dev server proxies /api to this backend URL
VITE_API_PROXY=http://127.0.0.1:5055

# Public site origin for canonical URLs, Open Graph, and Twitter cards (production)
# Example: https://www.mamahub.store
VITE_SITE_URL=

# WhatsApp support number (country code + number, no + or spaces). Leave empty to hide the button.
# Example: 97472352255
VITE_WHATSAPP_NUMBER=97472352255

# Optional Google Maps key. When set, the location picker loads:
# https://maps.googleapis.com/maps/api/js?key=YOUR_KEY&language=en  (or language=ar)
# VITE_GOOGLE_MAPS_API_KEY=

# Optional social profile URLs for the footer. Leave empty to use MamaHub defaults.
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/mamahub.store
# VITE_SOCIAL_X=https://x.com/mamahubstore
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/mamahub.store
# VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@mamahub.store
# VITE_SOCIAL_TIKTOK=https://www.tiktok.com/@mamahub.store
