FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=8080

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=30

CORS_ORIGINS=*

ORACLE_USER=erp_user
ORACLE_PASSWORD=erp_password
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=2
ENFORCE_TENANT_ASSIGNMENT=false

# Mobile app "Server & database" screen: save tenant rows to TENANT_DATABASES (header X-Config-Setup-Key).
# If unset, saves work only when FLASK_ENV=development. Leave empty in production unless you need mobile setup.
CONFIG_SETUP_KEY=

# Optional: provision GRN_MOBILE_LINE_EXT on first use (requires CREATE TABLE / INDEX on ERP schema user).
AUTO_CREATE_GRN_MOBILE_EXT=false

# ERP LRFLAG values = *partial receipt* only (comma-separated).
# Omit bare "P" if your ERP uses P = Pending/Open for all unpaid LPOs (that makes In progress show every PO).
# Example when your DB uses explicit partial codes: LRFLAG_PARTIAL_VALUES=PR,PART,PARTIAL
LRFLAG_PARTIAL_VALUES=PR,PART,PARTIAL

# LPOHDR varchar column for mobile GRN completion (default Pending; API sets Completed on GRN POST).
# Add once: erp_api/sql/add_lpohdr_nexa_grn_status_oracle.sql
LPOHDR_GRN_STATUS_COLUMN=NEXA_GRN_STATUS
